QWidget#GradeEditorWindow {
    background-color: #f8fafc;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    color: #0f172a;
}

QPushButton {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}

QPushButton#load_btn,
QPushButton#update_btn {
    background-color: #0284c7;
    color: #ffffff;
    border: 1px solid #0284c7;
}

QPushButton#load_btn:hover,
QPushButton#update_btn:hover {
    background-color: #0369a1;
}

QLabel {
    color: #0f172a;
}

QFrame#stats_bar {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

QLabel.stat-label {
    color: #334155;
    font-weight: 600;
    font-size: 12px;
}

QTableWidget {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #e2e8f0;
    selection-background-color: #e0f2fe;
    selection-color: #0f172a;
}

QTableWidget::item {
    color: #0f172a;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #334155;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    font-weight: 600;
}

QSpinBox#bonus_input {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 80px;
}
